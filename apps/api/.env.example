# Copy to apps/api/.env and fill in. Never commit the real file.

DATABASE_URL=postgresql://hungryman:CHANGE_ME@localhost:5432/hungryman
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Dashboard login (required in production). Dev falls back to "changeme".
ADMIN_PASSWORD=
# Random 32+ byte secret for session cookies:  openssl rand -hex 32
SESSION_SECRET=
# Bearer token for Cowork / Claude in Chrome sessions:  openssl rand -hex 32
AGENT_API_TOKEN=

# Generated CVs / cover letters. Encrypted at rest when the key is set (64 hex chars):  openssl rand -hex 32
STORAGE_DIR=./storage
STORAGE_ENCRYPTION_KEY=

# Claude API (optional — without it a deterministic engine is used)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
AI_ENABLED=true

# Official job-board APIs (optional)
# Reed: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=
# Adzuna: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

BROWSER_TASK_LEASE_MINUTES=30
# Set true to run the scheduler inside the API process instead of `npm run worker`
RUN_SCHEDULER_IN_API=false
